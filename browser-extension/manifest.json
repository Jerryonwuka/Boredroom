{
  "manifest_version": 3,
  "name": "Brenda for Chrome",
  "version": "0.1.0",
  "description": "Lets Brenda, your Boredroom assistant, use her own tabs in this Chrome profile while the Brenda Mac app is running.",
  "minimum_chrome_version": "120",
  "key": "",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "nativeMessaging",
    "identity",
    "identity.email"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
