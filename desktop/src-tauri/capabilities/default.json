    "allow-menu-bar-height",
    "allow-debug-log",
    "allow-upload-dropped",
    "allow-look-status",
    "allow-set-screen-help",
    "allow-look-set-options",
    "allow-look-request-permission",
    "allow-look-open-privacy-settings",
    "allow-look-now",
    "allow-look-send",
    "allow-look-follow-up",
    "allow-look-drop-held",
    "allow-look-discard",
    "allow-set-call-state",
    "allow-set-look-rules",
    "allow-companion-set-look",
