{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Boredroom",
  "version": "0.2.1",
  "identifier": "cc.boredroom.brenda",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "notch",
        "create": false,
        "title": "Brenda",
        "width": 480,
        "height": 440,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visibleOnAllWorkspaces": true,
        "focus": false,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Boredroom",
    "copyright": "© 2026 Boredroom",
    "category": "Productivity",
    "shortDescription": "Boredroom for Mac: your dashboard in its own window, and Brenda in your notch.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "entitlements": "./Entitlements.plist",
      "dmg": {
        "windowSize": {
          "width": 540,
          "height": 380
        },
        "appPosition": {
          "x": 140,
          "y": 190
        },
        "applicationFolderPosition": {
          "x": 400,
          "y": 190
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU0NDZDNThEOEI1NDZFMTQKUldRVWJsU0xqY1ZHNUwxQXJndjdNcVV1VjBSdVRkMFVxanlOU3VLTEcvRjJoWndHMGV4NUxwSzcK",
      "endpoints": [
        "https://github.com/Jerryonwuka/boredroom-releases/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
