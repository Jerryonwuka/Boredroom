# Boredroom environment variables. Copy to .env.local (never commit real values).

# --- Database -------------------------------------------------------------
# Superuser / owner connection used ONLY for migrations and seeding.
DATABASE_ADMIN_URL=postgres://boardroom_owner:boardroom_owner@localhost:5432/boardroom
# Restricted application role (NOSUPERUSER, NOBYPASSRLS). All web/worker queries
# run through this role so PostgreSQL row-level security is enforced.
DATABASE_URL=postgres://boardroom_app:boardroom_app@localhost:5432/boardroom
# Password that pnpm db:restore / pnpm db:move give the boardroom_app role on the target database.
# Leave empty to have a password generated (printed once). Set it to the role's real password on hosts
# such as Neon where you manage the role yourself, so the scripts never change it.
RESTORE_APP_PASSWORD=
# Development uses the database on this machine (owner request, 23 October 2026: docs/realtime.md). `pnpm dev`
# refuses a database elsewhere (Neon) unless this is 1, and then runs the web app only, never the worker; the worker
# refuses one whenever NODE_ENV isn't production. Leave it empty.
BOREDROOM_DEV_REMOTE_DB=
# Test database used by integration tests (migrated automatically).
TEST_DATABASE_ADMIN_URL=postgres://boardroom_owner:boardroom_owner@localhost:5432/boardroom_test
TEST_DATABASE_URL=postgres://boardroom_app:boardroom_app@localhost:5432/boardroom_test

# --- Web ------------------------------------------------------------------
# Public origin of the web app; used for invitation/verification links and CSRF origin checks.
APP_ORIGIN=http://localhost:3000
# Sign in with Google (optional). Create an OAuth client (Web application) in Google Cloud Console, add
# <APP_ORIGIN>/api/auth/google/callback as an authorised redirect URI, and paste the id and secret. The buttons
# appear on the sign-in and sign-up pages only when both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32+ random bytes, base64. Signs session cookies and short-lived media URLs.
APP_SECRET=change-me-generate-with-openssl-rand-base64-32
# development | test | production
NODE_ENV=development

# --- To-do assistant (optional) --------------------------------------------
# With a key, the My Day assistant uses Claude to turn notes into to-dos; without one a built-in parser runs.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5

# --- Screen help on Brenda for Mac (owner decisions, 11 October 2026) --------------------------------------
# Brenda for Mac can look at a person's front window when they ask her to (her keys or her Look button). It is offered in
# every workspace; each workspace's owners and HR switch it off in Settings › Brenda, and each person turns it on on their
# own Mac. Leave this empty. "off" turns it off everywhere (the kill switch); comma-separated slugs offer it only in those
# workspaces (a limited trial). Pictures always go through ANTHROPIC_API_KEY (Boredroom's own account), never a
# workspace's own key.
BRENDA_LOOK_WORKSPACES=
# The model that reads the pictures. Never a Fable or Mythos model (they can't run under zero data retention).
BRENDA_LOOK_MODEL=claude-opus-5-5
# Screen help, phase 2 (owner rule, 12 October 2026). How hard the look model thinks before answering (low is quickest):
BRENDA_LOOK_EFFORT=low
# The model that works on the person's Mac and on their files after they say yes (Boredroom's own key). Never Fable or Mythos.
BRENDA_ACT_MODEL=claude-opus-5-5
BRENDA_ACT_EFFORT=medium
# Brenda and her helpers (owner brief, 12 October 2026; all optional, these are the defaults; every one a Claude model on
# Boredroom's own key, never Fable or Mythos). Her front desk on the Mac: the model that picks what to do with a request
# the Mac couldn't match itself (words only, never a picture).
# BRENDA_ROUTER_MODEL=claude-haiku-5-5
# Quick questions about the screen ("think harder" ones use BRENDA_LOOK_MODEL above).
# BRENDA_LOOK_NOW_MODEL=claude-haiku-5-5
# The Files helper's background jobs (organise, rename, move, convert, summarise), and how hard it thinks.
# BRENDA_HELPER_MODEL=claude-sonnet-5-5
# BRENDA_HELPER_EFFORT=medium
# The Mac operator (clicking and typing for a job), and the stronger model it moves to when it struggles.
# BRENDA_OPERATOR_MODEL=claude-sonnet-5-5
# BRENDA_OPERATOR_STRONG_MODEL=claude-opus-5-5
# BRENDA_OPERATOR_EFFORT=medium

# --- Natural voice (optional) ------------------------------------------------
# Boredroom's ElevenLabs key: the fallback when a workspace has not added its own in Settings. Boredroom sets no daily
# limit of its own (owner request, 12 October 2026): only the ElevenLabs plan running out of credits moves assistants to
# the computer's own voice. Without one, assistants speak with the computer's own voice unless the workspace adds a key.
# It needs Text to Speech, Voices (read), User (read) and History (read and write): Boredroom deletes what assistants said
# from the key's History once it has played. Text-to-speech uses the key's credits; the tests never call it.
ELEVENLABS_API_KEY=

# --- Calls (optional) --------------------------------------------------------
# Calls (phase 8, owner decision 8 October 2026): LiveKit Cloud. LIVEKIT_URL is the project's wss:// address; the key and
# secret come from Settings → Keys. Never commit real values. Without all three, calls are off and every screen says so.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Boredroom for Mac (optional) ---------------------------------------------
# The Boredroom for Mac DMG (https). Unset: the GitHub releases default
# (https://github.com/Jerryonwuka/boredroom-releases/releases/latest/download/Boredroom.dmg). Set to `off` to stop
# offering it (the welcome then offers to link an installed app; /download says it isn't available right now).
# (Owner requests, 11 and 24 October 2026: the welcome and /download offer it.)
DESKTOP_DOWNLOAD_URL=

# --- Auth provider --------------------------------------------------------
# local     = built-in email/password store (development and tests)
# supabase  = Supabase Auth (see docs/providers.md for setup steps)
AUTH_PROVIDER=local
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Never exposed to the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=

# --- Mail -----------------------------------------------------------------
# sink   = write .json files to MAIL_SINK_DIR, readable at /dev/mail (development and tests; nothing is delivered)
# smtp   = real delivery over SMTP with Nodemailer (Brevo or any relay): set SMTP_URL and a verified MAIL_FROM
# resend = real delivery through resend.com: set RESEND_API_KEY and a MAIL_FROM on a domain verified in Resend
# Check either with `pnpm mail:test you@example.com` (see docs/providers.md).
MAIL_PROVIDER=sink
MAIL_SINK_DIR=./var/mail-outbox
MAIL_FROM="Boredroom <no-reply@boredroom.local>"
# Server-only. Never exposed to the browser bundle.
# Brevo: smtp://<brevo account email>:<smtp key>@smtp-relay.brevo.com:587 (URL-encode the login: @ becomes %40)
SMTP_URL=
RESEND_API_KEY=

# --- Object storage --------------------------------------------------------
# local    = private files under STORAGE_LOCAL_DIR served only through signed app URLs
# supabase = Supabase private Storage bucket (see docs/providers.md)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./var/storage
STORAGE_BUCKET=boredroom-private

# --- Malware scanning ------------------------------------------------------
# none = uploads stay in "pending_scan" quarantine until an adapter marks them clean
# clamav = ClamAV daemon (see docs/providers.md)
SCAN_PROVIDER=none
# Development only: mark unscanned uploads as clean so downloads work in local demos.
SCAN_ALLOW_UNSCANNED=false

# --- Worker ---------------------------------------------------------------
# Inside the widest working window of the active organisations (start − 90 min to end + 60 min on working days): a job
# claim every WORKER_POLL_INTERVAL_MS and the maintenance block every WORKER_MAINTENANCE_MS. Outside it, with nobody
# active, one pass and then a sleep until the next due job, reminder, routine, follow-up deadline or window start, at
# most WORKER_NIGHT_MAX_SLEEP_MIN minutes (decimals allowed). Nothing wakes that sleep early until phase 1, so work
# queued at night can wait up to the cap. See docs/realtime.md (owner request, 23 October 2026).
WORKER_POLL_INTERVAL_MS=2000
WORKER_MAINTENANCE_MS=15000
WORKER_NIGHT_MAX_SLEEP_MIN=60

# Boredroom Control Center (/admin). The first super admins, by account email, comma-separated; after that the console manages admins.
PLATFORM_SUPER_ADMINS=
# Paystack (payments). Prefer the Control Center: Settings, Paystack, where test and live pairs are stored encrypted.
# These are the fallback when nothing is stored there. The secret key signs webhooks; add <APP_ORIGIN>/api/billing/paystack/webhook as the webhook URL in Paystack.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Brevo API (contact sync and marketing lists). SMTP delivery stays on SMTP_URL.
BREVO_API_KEY=
BREVO_LIST_ID=

# --- Connected apps (owner decisions, 22 October 2026: connectors) ------------------------------------------------
# Every provider is optional. Without its variables its card says "Not set up yet" to owners and is hidden from everyone
# else. Redirect (callback) URLs are <APP_ORIGIN>/api/connectors/<slug>/callback; webhooks <APP_ORIGIN>/api/connectors/
# webhooks/<slug>. Most providers need APP_ORIGIN to be https (Slack always). Setup: docs/connectors/README.md.
# Encrypts connected apps' tokens: 32 random bytes, base64 (openssl rand -base64 32). Empty: derived from APP_SECRET.
# Changing it (or APP_SECRET when it is empty) disconnects every app.
CONNECTORS_TOKEN_KEY=
# Google Calendar (slug google-calendar): an OAuth client (Web application) in a Google Cloud project with the Google
# Calendar API enabled. APP_STATUS=testing shows people that Google asks them to reconnect weekly until verification.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_APP_STATUS=production
# Microsoft 365: one multitenant app registration for Outlook Calendar (slug outlook) and Microsoft Teams (slug teams).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Slack (slug slack): the app's Client ID, Client Secret and Signing Secret (Basic Information › App Credentials).
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Notion (slug notion): a public connection's OAuth client ID and secret (Developer portal › Configuration).
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# Linear (slug linear): an OAuth application's client ID and secret, and its webhook signing secret.
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_WEBHOOK_SECRET=
# Jira (slug jira): an Atlassian OAuth 2.0 (3LO) app's client ID and secret (also signs Jira's webhook tokens).
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
# GitHub (slug github): a GitHub App (Setup URL <APP_ORIGIN>/api/connectors/github/setup; organisation permission
# Members: read, so only an organisation owner can connect it for a workspace). PRIVATE_KEY: the .pem's contents with \n
# for line breaks, or base64 of the file.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
# Asana (slug asana): an app's client ID and secret (OAuth, specific scopes, distribution "Any workspace").
ASANA_CLIENT_ID=
ASANA_CLIENT_SECRET=
# Development only (ignored in production): a pretend app ("Test app") to try the screens and Brenda without accounts.
CONNECTORS_FAKE=
